# API calls stay same-origin (/api/v1) in every target:
# - dev (desktop and web): proxied by Vite to the targets below
# - web on Vercel: proxied by the rewrites in vercel.json
VITE_API_BASE_URL=/api/v1
VITE_API_PROXY_TARGET=http://127.0.0.1:5000
# FastAPI AI_Orchestration chat + speech API. Proxied via /api/v1/chat and /api/v1/speech.
VITE_CHAT_API_PROXY_TARGET=http://127.0.0.1:8000
# Also set this in Vercel → Project → Settings → Environment Variables.
VITE_GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
